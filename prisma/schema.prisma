generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  passwordHash String @map("password_hash")
  name String
  email String
  createdAt DateTime @default(now()) @map("created_at")

  // TOTP -- one authenticator enrollment at a time, matching how every
  // authenticator app models it. totpEnabledAt stays null while a scanned
  // QR hasn't yet been confirmed with a code, so a half-finished
  // enrollment never silently counts as "2FA enabled" (see totp/confirm).
  totpSecret String? @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at")

  webauthnCredentials WebauthnCredential[]
  recoveryCodes RecoveryCode[]
  @@map("users")
}

model WebauthnCredential {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  credentialId String @unique @map("credential_id")
  // Already base64url-encoded by @simplewebauthn/server's own success
  // callback -- stored as-is, never raw bytes.
  publicKey String @map("public_key")
  counter Int @default(0)
  backedUp Boolean @default(false) @map("backed_up")
  transports String[] @default([])
  aaguid String?
  // User-chosen label, e.g. "MacBook Touch ID" -- shown in Settings so
  // multiple passkeys can be told apart.
  name String
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("webauthn_credentials")
}

// Single-use fallback codes for when neither TOTP nor a passkey is
// available. A dedicated table (not a JSON column on User) so one code
// can be deleted/marked used independently -- same shape as ApiToken's
// hashed-secret pattern, reusing hashPassword/verifyPassword rather than
// a new hashing primitive.
model RecoveryCode {
  id Int @id @default(autoincrement())
  userId Int @map("user_id")
  codeHash String @map("code_hash")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("recovery_codes")
}

// A long-lived bearer credential for the MCP endpoint (server/routes/mcp.ts)
// only -- the web app itself still authenticates purely via the session
// cookie set by POST /api/auth/login. Multiple tokens are supported (one
// per MCP client) so any one of them can be revoked independently; there's
// no userId FK since the app supports exactly one account (see User).
model ApiToken {
  id Int @id @default(autoincrement())
  name String
  // First chars of the full token, stored in the clear so lookup doesn't
  // require hashing every row on every request -- see server/utils/api-tokens.ts.
  // Not a secret by itself; the hash below is what's actually checked.
  tokenPrefix String @map("token_prefix")
  tokenHash String @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  @@index([tokenPrefix])
  @@map("api_tokens")
}

model Project {
  id Int @id @default(autoincrement())
  identifier String @unique
  name String
  description String @default("")
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  phases Phase[]
  tasks Task[]
  events Event[]
  @@map("projects")
}

model Phase {
  id Int @id @default(autoincrement())
  projectId Int @map("project_id")
  name String
  description String @default("")
  position Int @default(0)
  status String @default("active")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks Task[]
  events Event[]
  @@index([projectId])
  @@map("phases")
}

model Task {
  id Int @id @default(autoincrement())
  projectId Int @map("project_id")
  phaseId Int @map("phase_id")
  title String
  description String @default("")
  status String @default("pending")
  position Int @default(0)
  command String?
  notes String?
  link String?
  reference String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  events Event[]
  @@index([projectId])
  @@index([phaseId])
  @@map("tasks")
}

model Event {
  id Int @id @default(autoincrement())
  projectId Int @map("project_id")
  scopeType String @default("project") @map("scope_type")
  scopeId Int @map("scope_id")
  type String @default("milestone")
  title String
  description String?
  expectedAt DateTime? @map("expected_at")
  status String @default("upcoming")
  createdAt DateTime @default(now()) @map("created_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId Int? @map("phase_id")
  phase Phase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  taskId Int? @map("task_id")
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([projectId])
  @@index([scopeType, scopeId])
  @@map("events")
}
