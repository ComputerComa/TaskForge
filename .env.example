# Copy to .env and fill in real values. .env is gitignored.

# Sealed session cookie secret used by nuxt-auth-utils. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Credentials for the single admin user created by `npm run db:seed`.
# There is no signup flow in this slice -- this is the only way an account
# gets created. Seeding is idempotent: it no-ops if a user already exists.
ADMIN_USERNAME=admin

# PostgreSQL connection string used by Prisma.
# Example: postgresql://user:password@localhost:5432/taskforge?schema=public
DATABASE_URL=
